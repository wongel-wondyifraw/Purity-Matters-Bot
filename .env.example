# Application Settings
PORT=3000
NODE_ENV=development

# Telegram Bot Token (Obtain from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Bot Delivery Mode: 'polling' (local dev) or 'webhook' (cPanel / production)
BOT_MODE=webhook

# Webhook Configuration (Required if BOT_MODE=webhook)
# Full public HTTPS URL domain (e.g. https://bot.yourdomain.com or https://yourdomain.com)
WEBHOOK_DOMAIN=https://yourdomain.com
WEBHOOK_PATH=/api/telegram/webhook

# Optional security token sent by Telegram in X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=a_random_secure_secret_token_123

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=purity_matters_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# JWT Authentication
JWT_SECRET=purity-matters-console-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Console Administrator Seeding from .env
DEFAULT_ADMIN_FIRST_NAME=Bereket
DEFAULT_ADMIN_MIDDLE_NAME=Tadesse
DEFAULT_ADMIN_LAST_NAME=Alemu
DEFAULT_ADMIN_EMAIL=admin@puritymatters.org
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_ROLE=superadmin

